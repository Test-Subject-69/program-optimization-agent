# Local development
# PORT is the backend API port. FRONTEND_ORIGIN is used for backend CORS and by the dev launcher.
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000

# Storage
# Use "memory" for the local pilot. Use "supabase" only after setting an elevated Supabase key.
DATABASE_MODE=memory

# Supabase backend
# SUPABASE_PUBLISHABLE_KEY is enough for Supabase Auth token validation.
# SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY is needed only when DATABASE_MODE=supabase.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase login UI
# Set both public values to enable /login. Leave blank to use demo auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
DEFAULT_SUPABASE_ROLE=read-only

# AI reports
# Leave OPENAI_API_KEY blank to use deterministic demo summaries.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Demo auth
# Used when Supabase login is not configured.
AUTH_JWT_SECRET=change-this-local-demo-secret
AUTH_JWT_ISSUER=walker-miller-program-optimization-agent
AUTH_JWT_AUDIENCE=program-optimization-ui
AUTH_JWT_TTL_SECONDS=43200
DEFAULT_DEMO_ROLE=admin
